# {{ output_name }}
# ─────────────────────────────────────────────────────────────────────────────
# GENERATED by generate-setup from integration-setup.yaml. Do not edit by hand.
#
# Initial WorkerPool CR: provisions the HCI gateway only (workers.count: 0).
# Apply it once the operators are deployed:
#
#   oc --context {{ consumer.context }} apply -f {{ output_name }}
#
# Then scale by editing the live resource:
#
#   oc --context {{ consumer.context }} -n {{ consumer.operatorNamespace }} \
#       edit workerpool {{ pool_name }}
#
# To persist the live state, use `oc get workerpool {{ pool_name }} -o yaml`.
# Regenerating from integration-setup.yaml resets workers.count to 0.
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: hci-integration.openshift.io/v1alpha1
kind: WorkerPool
metadata:
  name: {{ pool_name }}
  namespace: {{ consumer.operatorNamespace | tojson }}

spec:
  provider:
    apiEndpoint: {{ provider.apiEndpoint | tojson }}
    namespace: {{ provider.namespace | tojson }}
    credentialsSecret: {{ credentials_secret | tojson }}
    maxPoolSize: {{ provider.maxPoolSize }}
    gateway:
      ip: {{ provider.gateway.ip | tojson }}
      prefixLength: {{ provider.gateway.prefixLength }}
      defaultRouter: {{ provider.gateway.defaultRouter | tojson }}
{% if provider.gateway.resources is defined %}
      resources: {{ provider.gateway.resources | tojson }}
{% endif %}
    networking:
      macPrefix: {{ provider.networking.macPrefix | tojson }}
      internalSubnet: {{ provider.networking.internalSubnet | tojson }}

  consumer:
    machineConfigPool: {{ consumer.machineConfigPool | tojson }}
    networking:
      topology: {{ consumer.networking.topology | tojson }}
      dnsServer: {{ consumer.networking.dnsServer | tojson }}
{% if consumer.networking.topology == "mediated" %}
      internalNetwork: {{ consumer.networking.internalNetwork | tojson }}
      internalGateway: {{ consumer.networking.internalGateway | tojson }}
{% endif %}
    workers:
      count: 0
      namePrefix: {{ consumer.workers.namePrefix | tojson }}
{% if consumer.workers.resources is defined %}
      resources: {{ consumer.workers.resources | tojson }}
{% endif %}
