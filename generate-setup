#!/usr/bin/env python3
"""
generate-setup — derive all environment-specific artifacts from the cluster's
single inventory config file, integration-setup.yaml.

Usage:
    ./generate-setup <integration-setup.yaml>

Outputs written into the working copy:
    setup_env.sh                                            (repo root)
    workspace/workerpool-<name>.yaml                        (initial WorkerPool CR, count: 0)
    operator/build/config.env                               (Makefile vars)
    main-cluster/configuration/overlays/direct/             (direct topology only)
        99-master-s390x-hci-network-route.yaml
        99-worker-s390x-hci-network-route.yaml
    workspace/<domain>.zone                                 (forward DNS zone section)
    workspace/<subnet>.in-addr.arpa.zone                   (reverse DNS zonefile)
"""

import ipaddress
import os
import sys
import textwrap
from pathlib import Path

try:
    import yaml
except ImportError:
    sys.exit("Error: PyYAML is required.  Install with: pip install pyyaml")

try:
    import jinja2
except ImportError:
    sys.exit("Error: Jinja2 is required.  Install with: pip install jinja2")

# Defaults mirror the WorkerPool CRD defaults (operator/hci-consumer/config/crd/workerpool.yaml).
POOL_NAME = "hci-workers"
CREDENTIALS_SECRET = "hci-provisioner-credentials"

# ── helpers ────────────────────────────────────────────────────────────────────

def load_yaml(path: Path) -> dict:
    with path.open() as fh:
        data = yaml.safe_load(fh)
    if not isinstance(data, dict):
        sys.exit(f"Error: {path} did not parse as a YAML mapping.")
    return data


def require(mapping: dict, *keys: str):
    """Walk a nested mapping and return the value; exit with a clear message if missing."""
    node = mapping
    path_str = ".".join(keys)
    for k in keys:
        if not isinstance(node, dict) or k not in node:
            sys.exit(f"Error: required field '{path_str}' is missing from the config file.")
        node = node[k]
    return node


def derive_network(subnet_cidr: str) -> tuple[str, str]:
    """Return (gateway_internal_ip, worker_start_ip) from a /24 CIDR."""
    net = ipaddress.IPv4Network(subnet_cidr, strict=False)
    hosts = list(net.hosts())
    if len(hosts) < 10:
        sys.exit(f"Error: internalSubnet {subnet_cidr} is too small (need at least 10 host addresses).")
    gateway_internal = str(hosts[0])   # network + .1
    worker_start     = str(hosts[9])   # network + .10
    return gateway_internal, worker_start


def write_file(path: Path, content: str, label: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    print(f"  wrote  {path}")


def apply_defaults_and_validate(setup: dict) -> None:
    """Fill optional fields with the WorkerPool CRD defaults and enforce the
    CRD's required fields, so errors surface before anything is generated."""
    for section in ("consumer", "provider", "registry"):
        require(setup, section)
    c, p = setup["consumer"], setup["provider"]

    # A section holding only comments parses as None; treat it as empty.
    if c.get("workers") is None:
        c["workers"] = {}

    # Required: no sensible default.
    require(setup, "consumer", "context")
    require(setup, "consumer", "domain")
    require(setup, "consumer", "operatorNamespace")
    require(setup, "consumer", "networking", "dnsServer")
    require(setup, "provider", "context")
    require(setup, "provider", "apiEndpoint")
    require(setup, "provider", "namespace")
    require(setup, "provider", "gateway", "ip")
    require(setup, "provider", "gateway", "prefixLength")
    require(setup, "provider", "gateway", "defaultRouter")
    require(setup, "provider", "networking", "internalSubnet")

    # Optional: CRD defaults.
    p.setdefault("maxPoolSize", 10)
    p["networking"].setdefault("macPrefix", "52:54:00")
    c.setdefault("machineConfigPool", "hci-vm")
    c["networking"].setdefault("topology", "direct")
    c.setdefault("workers", {}).setdefault("namePrefix", "worker-x86")

    if c["networking"]["topology"] not in ("direct", "mediated"):
        sys.exit("Error: consumer.networking.topology must be 'direct' or 'mediated'.")
    if c["networking"]["topology"] == "mediated":
        require(setup, "consumer", "networking", "internalNetwork")
        require(setup, "consumer", "networking", "internalGateway")
    if int(p["maxPoolSize"]) < 1:
        sys.exit("Error: provider.maxPoolSize must be >= 1.")


def generate_workerpool_cr(setup: dict, repo_root: Path) -> Path:
    """Render the initial WorkerPool CR (gateway only, count: 0) from the setup."""
    env = jinja2.Environment(
        loader=jinja2.FileSystemLoader(str(repo_root / "templates")),
        undefined=jinja2.StrictUndefined,
        trim_blocks=True,
        lstrip_blocks=True,
        keep_trailing_newline=True,
    )
    output_name = f"workerpool-{POOL_NAME}.yaml"
    content = env.get_template("workerpool.yaml.j2").render(
        consumer=setup["consumer"],
        provider=setup["provider"],
        pool_name=POOL_NAME,
        credentials_secret=CREDENTIALS_SECRET,
        output_name=output_name,
    )
    # Fail here, not at apply time, if the rendered CR is not valid YAML.
    yaml.safe_load(content)

    dest = repo_root / "workspace" / output_name
    write_file(dest, content, "WorkerPool CR")
    return dest


# ── generators ─────────────────────────────────────────────────────────────────

def generate_setup_env(setup: dict, repo_root: Path) -> None:
    c  = setup["consumer"]
    p  = setup["provider"]
    r  = setup["registry"]

    # Derived network values
    subnet_cidr = require(p, "networking", "internalSubnet")
    gateway_internal, worker_start = derive_network(subnet_cidr)
    gateway_external = require(p, "gateway", "ip")
    mac_prefix       = require(p, "networking", "macPrefix")
    max_pool_size    = require(p, "maxPoolSize")
    name_prefix      = require(c, "workers", "namePrefix")

    operator_ns      = require(c, "operatorNamespace")
    hci_ns           = require(p, "namespace")
    registry_model   = require(r, "model")

    # Registry-model-dependent variables
    if registry_model in ("cross-cluster", "external"):
        proxy_port      = r.get("proxyPort", "")
        registry_secret = r.get("secretName", "")
        registry_sa     = r.get("saName", "")
        hci_registry    = require(p, "registryHostname")
    else:
        proxy_port = registry_secret = registry_sa = hci_registry = ""

    bastion_host = c.get("bastion", {}).get("host", f"bastion.{c['domain']}")
    bastion_user = c.get("bastion", {}).get("user", "root")

    content = textwrap.dedent(f"""\
        #!/bin/bash
        # setup_env.sh — GENERATED by generate-setup. Do not edit by hand.
        #
        # Source:
        #   integration-setup.yaml  →  cluster-pair + initial WorkerPool config
        #
        # Re-generate with:
        #   ./generate-setup <path/to/integration-setup.yaml>
        #
        # Usage:
        #   source setup_env.sh
        #   # then: oc, make, and all scripts talk to the configured cluster pair

        # Prevent multiple sourcing
        if [ -n "${{SETUP_ENV_LOADED}}" ]; then return 0; fi
        export SETUP_ENV_LOADED=1

        # ── Cluster contexts ──────────────────────────────────────────────────────
        export MAIN_CLUSTER_CONTEXT="{c['context']}"
        export HCI_CLUSTER_CONTEXT="{p['context']}"

        # ── Consumer cluster ──────────────────────────────────────────────────────
        export MAIN_CLUSTER_DOMAIN="{c['domain']}"
        export BASTION_HOST="{bastion_host}"
        export BASTION_USER="{bastion_user}"

        # ── Namespaces ────────────────────────────────────────────────────────────
        # Namespace where hci-consumer and hci-provisioner operators run (consumer cluster)
        export MAIN_INTEGRATION_NAMESPACE="{operator_ns}"
        # Namespace where worker VMs are created (provider/HCI cluster)
        export HCI_INTEGRATION_NAMESPACE="{hci_ns}"

        # ── Network — from integration-setup.yaml provider.* ───────────────────────
        export ROUTER_VM_EXTERNAL="{gateway_external}"   # provider.gateway.ip
        export ROUTER_VM_INTERNAL="{gateway_internal}"   # internalSubnet + .1
        export INTERNAL_NETWORK="{subnet_cidr}"          # provider.networking.internalSubnet
        export MAC_PREFIX="{mac_prefix}"                 # provider.networking.macPrefix

        # ── Worker pool — from integration-setup.yaml ─────────────────────────────
        export WORKER_MAX_POOL_SIZE="{max_pool_size}"
        export WORKER_START_IP="{worker_start}"          # internalSubnet + .10
        export WORKER_NAME_PREFIX="{name_prefix}"

        # ── Registry ──────────────────────────────────────────────────────────────
        export HCI_REGISTRY="{hci_registry}"
        export REGISTRY_SA_NAME="{registry_sa}"
        export REGISTRY_SECRET_NAME="{registry_secret}"
        export REGISTRY_PROXY_PORT="{proxy_port}"

        # ── Constants (protocol ports — do not change) ────────────────────────────
        readonly TFTP_PORT=69
        readonly HTTP_PORT=80
        readonly HTTPS_PORT=443
        readonly DHCP_PORT=67
        readonly DNS_PORT=53
        readonly API_PORT=6443
        readonly MCS_PORT=22623
        export TFTP_PORT HTTP_PORT HTTPS_PORT DHCP_PORT DNS_PORT API_PORT MCS_PORT

        # ── Backward-compatibility aliases ────────────────────────────────────────
        export ROUTER_VM_IP="${{ROUTER_VM_EXTERNAL}}"
        export CLUSTER_DOMAIN="${{MAIN_CLUSTER_DOMAIN}}"
        export BUILD_CLUSTER_CONTEXT="${{MAIN_CLUSTER_CONTEXT}}"
        export REGISTRY_CLUSTER_CONTEXT="${{HCI_CLUSTER_CONTEXT}}"
        export BUILD_NAMESPACE="${{MAIN_INTEGRATION_NAMESPACE}}"
        export REGISTRY_NAMESPACE="${{HCI_INTEGRATION_NAMESPACE}}"

        # ── Output formatting ─────────────────────────────────────────────────────
        export RED='\\033[0;31m'
        export GREEN='\\033[0;32m'
        export YELLOW='\\033[1;33m'
        export BLUE='\\033[0;34m'
        export NC='\\033[0m'

        echo "Loaded setup_env.sh for cluster pair: ${{MAIN_CLUSTER_CONTEXT}} ↔ ${{HCI_CLUSTER_CONTEXT}}"
        echo "  consumer domain : ${{MAIN_CLUSTER_DOMAIN}}"
        echo "  operator ns     : ${{MAIN_INTEGRATION_NAMESPACE}}"
        echo "  registry model  : {registry_model}"
        echo ""
    """)

    write_file(repo_root / "setup_env.sh", content, "setup_env.sh")
    os.chmod(repo_root / "setup_env.sh", 0o644)


def generate_config_env(setup: dict, repo_root: Path) -> None:
    c  = setup["consumer"]
    p  = setup["provider"]
    r  = setup["registry"]

    operator_ns    = require(c, "operatorNamespace")
    registry_model = require(r, "model")
    hci_ns         = require(p, "namespace")

    if registry_model == "cross-cluster":
        bastion_host    = c.get("bastion", {}).get("host", f"bastion.{c['domain']}")
        proxy_port      = require(r, "proxyPort")
        registry_secret = require(r, "secretName")
        registry_push   = f"{bastion_host}:{proxy_port}/{hci_ns}"
        registry_pull   = f"{bastion_host}:{proxy_port}/{hci_ns}"
    elif registry_model == "external":
        registry_push   = r.get("repository", "")
        registry_pull   = r.get("repository", "")
        registry_secret = r.get("pullSecretName", "")
    else:  # local-s2i
        registry_push   = ""
        registry_secret = ""
        registry_pull   = f"image-registry.openshift-image-registry.svc:5000/{operator_ns}"

    content = textwrap.dedent(f"""\
        # operator/build/config.env — GENERATED by generate-setup. Do not edit by hand.
        #
        # Re-generate with:
        #   ./generate-setup <path/to/integration-setup.yaml>

        # ── Namespace ─────────────────────────────────────────────────────────────
        OPERATOR_NAMESPACE ?= {operator_ns}

        # ── Image names ───────────────────────────────────────────────────────────
        CONSUMER_IMAGE_NAME    ?= hci-consumer-operator
        PROVISIONER_IMAGE_NAME ?= hci-provisioner-operator
        IMAGE_TAG              ?= latest

        # ── Registry model: {registry_model} ─────────────────────────────────────
        REGISTRY_PUSH        ?= {registry_push}
        REGISTRY_SECRET_NAME ?= {registry_secret}
        REGISTRY_PULL        ?= {registry_pull}
    """)

    dest = repo_root / "operator" / "build" / "config.env"
    write_file(dest, content, "operator/build/config.env")


def generate_machineconfigs(setup: dict, repo_root: Path) -> None:
    c        = setup["consumer"]
    p        = setup["provider"]
    topology = require(c, "networking", "topology")

    if topology != "direct":
        print(f"  skip   MachineConfig route YAMLs (topology={topology}, none needed for mediated)")
        return

    subnet_cidr      = require(p, "networking", "internalSubnet")
    gateway_external = require(p, "gateway", "ip")

    # For direct topology the static route on LO nodes points the internal subnet
    # at the gateway VM's external IP (which is reachable from the physical network).
    overlay_dir = repo_root / "main-cluster" / "configuration" / "overlays" / "direct"

    worker_mc = textwrap.dedent(f"""\
        # 99-worker-s390x-hci-network-route.yaml — GENERATED by generate-setup.
        # Re-generate with: ./generate-setup <path/to/integration-setup.yaml>
        apiVersion: machineconfiguration.openshift.io/v1
        kind: MachineConfig
        metadata:
          labels:
            machineconfiguration.openshift.io/role: worker
            node-platform: s390x
          name: 99-worker-s390x-hci-network-route
        spec:
          config:
            ignition:
              version: 3.5.0
            systemd:
              units:
                - name: hci-network-route.service
                  enabled: true
                  contents: |
                    [Unit]
                    Description=Add static route to HCI worker network
                    After=network-online.target
                    Wants=network-online.target

                    [Service]
                    Type=oneshot
                    RemainAfterExit=yes
                    ExecStart=/bin/bash -c '/usr/sbin/ip route add {subnet_cidr} via {gateway_external} || true'

                    [Install]
                    WantedBy=multi-user.target
    """)

    master_mc = textwrap.dedent(f"""\
        # 99-master-s390x-hci-network-route.yaml — GENERATED by generate-setup.
        # Re-generate with: ./generate-setup <path/to/integration-setup.yaml>
        apiVersion: machineconfiguration.openshift.io/v1
        kind: MachineConfig
        metadata:
          labels:
            machineconfiguration.openshift.io/role: master
          name: 99-master-s390x-hci-network-route
        spec:
          config:
            ignition:
              version: 3.5.0
            systemd:
              units:
                - name: hci-network-route.service
                  enabled: true
                  contents: |
                    [Unit]
                    Description=Add static route to HCI worker network
                    After=network-online.target ovs-configuration.service
                    Wants=network-online.target
                    Requires=ovs-configuration.service

                    [Service]
                    Type=oneshot
                    RemainAfterExit=yes
                    ExecStartPre=/bin/bash -c 'until ip link show br-ex; do sleep 1; done'
                    ExecStart=/bin/bash -c '/usr/sbin/ip route add {subnet_cidr} via {gateway_external} dev br-ex || true'

                    [Install]
                    WantedBy=multi-user.target
    """)

    write_file(overlay_dir / "99-worker-s390x-hci-network-route.yaml", worker_mc, "worker MachineConfig")
    write_file(overlay_dir / "99-master-s390x-hci-network-route.yaml", master_mc, "master MachineConfig")


def generate_dns_zones(setup: dict, repo_root: Path) -> None:
    c = setup["consumer"]
    p = setup["provider"]

    domain           = require(c, "domain")
    subnet_cidr      = require(p, "networking", "internalSubnet")
    gateway_external = require(p, "gateway", "ip")
    max_pool_size    = int(require(p, "maxPoolSize"))
    name_prefix      = require(c, "workers", "namePrefix")

    net = ipaddress.IPv4Network(subnet_cidr, strict=False)
    hosts = list(net.hosts())
    if len(hosts) < 9 + max_pool_size:
        sys.exit(f"Error: internalSubnet {subnet_cidr} is too small for maxPoolSize {max_pool_size}.")

    if net.prefixlen == 24:
        rev_prefix = net.network_address.exploded.rsplit(".", 1)[0]
    else:
        octets = net.network_address.exploded.split(".")
        rev_prefix = ".".join(octets[:3])

    gw_fqdn = f"hci-gateway.{domain}."
    forward_records = [
        f"; Gateway VM external interface",
        f"{gw_fqdn:<40}  IN  A    {gateway_external}",
        "",
        f"; Worker nodes (1..{max_pool_size})",
    ]
    reverse_records = []

    for i in range(1, max_pool_size + 1):
        worker_ip   = str(hosts[8 + i])
        last_octet  = worker_ip.split(".")[-1]
        worker_fqdn = f"{name_prefix}-{i}.{domain}."

        forward_records.append(f"{worker_fqdn:<40}  IN  A    {worker_ip}")
        reverse_records.append(f"{last_octet:<4}  IN  PTR  {worker_fqdn}")

    forward_content = textwrap.dedent(f"""\
        ; Forward zone entries for HCI gateway and worker nodes — GENERATED by generate-setup.
        ; Section to be included into /var/named/{domain}.zone
        ;
        ; Domain: {domain}
        ; Gateway: {gateway_external}
        ; Worker pool size: {max_pool_size} ({name_prefix}-1 .. {name_prefix}-{max_pool_size})
        ;
        ; Re-generate with:
        ;   ./generate-setup <path/to/integration-setup.yaml>

        """) + "\n".join(forward_records) + "\n"

    reverse_content = textwrap.dedent(f"""\
        ; Reverse lookup zonefile for HCI worker nodes — GENERATED by generate-setup.
        ; Place or merge into /var/named/{rev_prefix}.in-addr.arpa.zone
        ;
        ; Subnet: {subnet_cidr}
        ; Worker pool size: {max_pool_size} ({name_prefix}-1 .. {name_prefix}-{max_pool_size})
        ;
        ; Re-generate with:
        ;   ./generate-setup <path/to/integration-setup.yaml>

        """) + "\n".join(reverse_records) + "\n"

    dest_forward = repo_root / "workspace" / f"{domain}.zone"
    dest_reverse = repo_root / "workspace" / f"{rev_prefix}.in-addr.arpa.zone"

    write_file(dest_forward, forward_content, f"forward DNS zone section ({dest_forward.name})")
    write_file(dest_reverse, reverse_content, f"reverse DNS zonefile ({dest_reverse.name})")


# ── main ───────────────────────────────────────────────────────────────────────

def main() -> None:
    if len(sys.argv) != 2:
        print(__doc__)
        sys.exit("Usage: ./generate-setup <integration-setup.yaml>")

    setup_path = Path(sys.argv[1])
    if not setup_path.exists():
        sys.exit(f"Error: file not found: {setup_path}")

    setup = load_yaml(setup_path)
    apply_defaults_and_validate(setup)

    # Resolve repo root as the directory containing this script
    repo_root = Path(__file__).resolve().parent

    print("generate-setup")
    print(f"  integration-setup : {setup_path}")
    print(f"  repo root         : {repo_root}")
    print()

    generate_setup_env(setup, repo_root)
    generate_config_env(setup, repo_root)
    generate_machineconfigs(setup, repo_root)
    generate_dns_zones(setup, repo_root)
    pool_cr = generate_workerpool_cr(setup, repo_root)

    print()
    print("Done.  Next steps:")
    print("  source setup_env.sh")
    print("  make apply-buildconfigs && make build && make deploy")
    print(f"  oc --context {setup['consumer']['context']} apply -f {pool_cr}")
    print("  oc edit workerpool to scale workers up (the generated CR has count: 0)")


if __name__ == "__main__":
    main()
